generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Citizen {
  aadharNumber        String              @id @db.VarChar(12)
  fullName            String              @db.VarChar(150)
  mobileNumber        String              @unique @db.VarChar(10)
  email               String?             @db.VarChar(150)
  languagePref        String              @default("en") @db.VarChar(10)
  createdAt           DateTime            @default(now())
  aadharHash          String              @unique
  address             String?
  dateOfBirth         DateTime?           @db.Date
  gender              String?             @db.VarChar(10)
  isActive            Boolean             @default(true)
  isVerified          Boolean             @default(false)
  lastLoginAt         DateTime?
  updatedAt           DateTime            @updatedAt
  auditLogs           AuditLog[]
  authSessions        AuthSession[]
  complaints          Complaint[]
  documents           Document[]
  electricityAccounts ElectricityAccount?
  gasAccounts         GasAccount?
  kioskLogs           KioskLog[]
  municipalAccounts   MunicipalAccount?
  otpVerifications    OTPVerification[]
  serviceAccounts     ServiceAccount[]
  serviceRequests     ServiceRequest[]
  waterAccounts       WaterAccount?

  @@index([aadharHash])
  @@index([mobileNumber])
  @@map("citizens")
}

model OTPVerification {
  otpId        String   @id @default(uuid()) @db.Uuid
  citizenId    String?  @db.VarChar(12)
  otpHash      String   @db.VarChar(64)
  purpose      String   @db.VarChar(20)
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  expiresAt    DateTime
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  mobileNumber String?  @db.VarChar(10)
  citizen      Citizen? @relation(fields: [citizenId], references: [aadharNumber], onDelete: Cascade)

  @@index([citizenId, isVerified])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model AuthSession {
  sessionId      String   @id @default(uuid()) @db.Uuid
  citizenId      String   @db.VarChar(12)
  tokenHash      String   @db.VarChar(64)
  kioskId        String?  @db.VarChar(30)
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(255)
  expiresAt      DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  citizen        Citizen  @relation(fields: [citizenId], references: [aadharNumber], onDelete: Cascade)

  @@index([citizenId, isActive])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuditLog {
  logId     String   @id @default(uuid()) @db.Uuid
  citizenId String?  @db.VarChar(12)
  action    String   @db.VarChar(50)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  metadata  Json?
  timestamp DateTime @default(now())
  citizen   Citizen? @relation(fields: [citizenId], references: [aadharNumber])

  @@index([citizenId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model ServiceAccount {
  accountId     String  @id @default(uuid()) @db.Uuid
  citizenId     String  @db.VarChar(12)
  serviceType   String  @db.VarChar(20)
  accountNumber String? @db.VarChar(30)
  status        String  @db.VarChar(20)
  bills         Bill[]
  citizen       Citizen @relation(fields: [citizenId], references: [aadharNumber])

  @@map("service_accounts")
}

model Bill {
  billId        String         @id @default(uuid()) @db.Uuid
  accountId     String         @db.Uuid
  billingDate   DateTime?      @db.Date
  billingPeriod String?        @db.VarChar(20)
  amount        Decimal?       @db.Decimal(10, 2)
  dueDate       DateTime?      @db.Date
  status        String         @db.VarChar(20)
  account       ServiceAccount @relation(fields: [accountId], references: [accountId])
  payments      Payment[]

  @@map("bills")
}

model Payment {
  paymentId         String           @id @default(uuid()) @db.Uuid
  billId            String?          @db.Uuid
  gateway           String?          @db.VarChar(30)
  transactionRef    String?          @db.VarChar(100)
  amount            Decimal          @db.Decimal(10, 2)
  status            String           @db.VarChar(20)
  paidAt            DateTime         @default(now())
  billType          String?          @db.VarChar(20)
  electricityBillId String?          @db.Uuid
  gasBillId         String?          @db.Uuid
  municipalBillId   String?          @db.Uuid
  waterBillId       String?          @db.Uuid
  bill              Bill?            @relation(fields: [billId], references: [billId])
  electricityBill   ElectricityBill? @relation(fields: [electricityBillId], references: [billId])
  gasBill           GasBill?         @relation(fields: [gasBillId], references: [billId])
  municipalBill     MunicipalBill?   @relation(fields: [municipalBillId], references: [billId])
  waterBill         WaterBill?       @relation(fields: [waterBillId], references: [billId])

  @@index([billType])
  @@map("payments")
}

model Complaint {
  complaintId    String                   @id @default(uuid()) @db.Uuid
  citizenId      String                   @db.VarChar(12)
  serviceType    String                   @db.VarChar(20)
  description    String
  status         String                   @db.VarChar(20)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  assignedTo     String?                  @db.VarChar(12)
  complaintType  String                   @db.VarChar(50)
  kioskId        String?                  @db.VarChar(30)
  location       String?                  @db.VarChar(255)
  priority       String                   @db.VarChar(20)
  resolutionNote String?
  resolvedAt     DateTime?
  title          String                   @db.VarChar(200)
  statusHistory  ComplaintStatusHistory[]
  citizen        Citizen                  @relation(fields: [citizenId], references: [aadharNumber])

  @@index([citizenId])
  @@index([status])
  @@map("complaints")
}

model ComplaintStatusHistory {
  historyId   String    @id @default(uuid()) @db.Uuid
  complaintId String    @db.Uuid
  oldStatus   String?   @db.VarChar(20)
  newStatus   String    @db.VarChar(20)
  changedBy   String?   @db.VarChar(12)
  notes       String?
  changedAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_status_history")
}

model ServiceRequestType {
  requestTypeCode String           @id @db.VarChar(30)
  description     String?
  isActive        Boolean          @default(true)
  serviceRequests ServiceRequest[]

  @@map("service_request_types")
}

model ServiceRequest {
  requestId   String             @id @default(uuid()) @db.Uuid
  citizenId   String             @db.VarChar(12)
  serviceType String             @db.VarChar(20)
  requestType String             @db.VarChar(30)
  status      String             @db.VarChar(20)
  details     Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime?
  citizen     Citizen            @relation(fields: [citizenId], references: [aadharNumber])
  type        ServiceRequestType @relation(fields: [requestType], references: [requestTypeCode])

  @@map("service_requests")
}

model Document {
  documentId    String   @id @default(uuid()) @db.Uuid
  citizenId     String   @db.VarChar(12)
  relatedEntity String   @db.VarChar(30)
  relatedId     String   @db.Uuid
  documentType  String   @db.VarChar(30)
  fileName      String?  @db.VarChar(255)
  filePath      String
  uploadedAt    DateTime @default(now())
  fileSize      Int?
  mimeType      String?  @db.VarChar(100)
  citizen       Citizen  @relation(fields: [citizenId], references: [aadharNumber])

  @@index([relatedEntity, relatedId])
  @@map("documents")
}

model Alert {
  alertId     String    @id @default(uuid()) @db.Uuid
  alertType   String    @db.VarChar(30)
  serviceType String?   @db.VarChar(20)
  title       String    @db.VarChar(150)
  message     String
  severity    String?   @db.VarChar(20)
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("alerts")
}

model KioskLog {
  logId     String   @id @default(uuid()) @db.Uuid
  kioskId   String   @db.VarChar(30)
  citizenId String?  @db.VarChar(12)
  action    String   @db.VarChar(50)
  metadata  Json?
  timestamp DateTime @default(now())
  citizen   Citizen? @relation(fields: [citizenId], references: [aadharNumber])

  @@map("kiosk_logs")
}

model ElectricityAccount {
  accountId          String                   @id @db.Uuid
  citizenId          String                   @unique @db.VarChar(12)
  consumerNumber     String                   @unique @db.VarChar(30)
  connectionType     String                   @db.VarChar(20)
  sanctionedLoad     String                   @db.VarChar(20)
  status             String                   @db.VarChar(20)
  currentMonthUsage  Float?
  dailyAverage       Float?
  peakLoad           Float?
  lastBillAmount     Decimal?                 @db.Decimal(10, 2)
  lastReadingDate    DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime
  citizen            Citizen                  @relation(fields: [citizenId], references: [aadharNumber], onDelete: Cascade)
  bills              ElectricityBill[]
  consumptionHistory ElectricityConsumption[]

  @@index([consumerNumber])
  @@index([status])
  @@map("electricity_accounts")
}

model ElectricityBill {
  billId           String             @id @db.Uuid
  accountId        String             @db.Uuid
  billNumber       String             @unique @db.VarChar(30)
  billingPeriod    String             @db.VarChar(20)
  billingStartDate DateTime           @db.Date
  billingEndDate   DateTime           @db.Date
  unitsConsumed    Float
  previousReading  Float
  currentReading   Float
  energyCharges    Decimal            @db.Decimal(10, 2)
  fixedCharges     Decimal            @db.Decimal(10, 2)
  demandCharges    Decimal?           @db.Decimal(10, 2)
  taxAmount        Decimal            @db.Decimal(10, 2)
  totalAmount      Decimal            @db.Decimal(10, 2)
  dueDate          DateTime           @db.Date
  status           String             @db.VarChar(20)
  createdAt        DateTime           @default(now())
  account          ElectricityAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  payments         Payment[]

  @@index([accountId])
  @@index([status])
  @@map("electricity_bills")
}

model ElectricityConsumption {
  id          String             @id @db.Uuid
  accountId   String             @db.Uuid
  date        DateTime           @db.Date
  consumption Float
  createdAt   DateTime           @default(now())
  account     ElectricityAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, date])
  @@map("electricity_consumption")
}

model GasAccount {
  accountId          String           @id @db.Uuid
  citizenId          String           @unique @db.VarChar(12)
  consumerNumber     String           @unique @db.VarChar(30)
  connectionType     String           @db.VarChar(20)
  gasType            String           @db.VarChar(20)
  pipelineSize       String?          @db.VarChar(20)
  status             String           @db.VarChar(20)
  currentMonthUsage  Float?
  dailyAverage       Float?
  pressure           Float?
  lastBillAmount     Decimal?         @db.Decimal(10, 2)
  lastReadingDate    DateTime?
  nextSafetyCheck    DateTime?        @db.Date
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  citizen            Citizen          @relation(fields: [citizenId], references: [aadharNumber], onDelete: Cascade)
  bills              GasBill[]
  consumptionHistory GasConsumption[]

  @@index([consumerNumber])
  @@map("gas_accounts")
}

model GasBill {
  billId           String     @id @db.Uuid
  accountId        String     @db.Uuid
  billNumber       String     @unique @db.VarChar(30)
  billingPeriod    String     @db.VarChar(20)
  billingStartDate DateTime   @db.Date
  billingEndDate   DateTime   @db.Date
  unitsConsumed    Float
  previousReading  Float
  currentReading   Float
  gasCharges       Decimal    @db.Decimal(10, 2)
  fixedCharges     Decimal    @db.Decimal(10, 2)
  taxAmount        Decimal    @db.Decimal(10, 2)
  totalAmount      Decimal    @db.Decimal(10, 2)
  dueDate          DateTime   @db.Date
  status           String     @db.VarChar(20)
  createdAt        DateTime   @default(now())
  account          GasAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  payments         Payment[]

  @@index([accountId])
  @@map("gas_bills")
}

model GasConsumption {
  id          String     @id @db.Uuid
  accountId   String     @db.Uuid
  date        DateTime   @db.Date
  consumption Float
  pressure    Float?
  createdAt   DateTime   @default(now())
  account     GasAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, date])
  @@map("gas_consumption")
}

model MunicipalAccount {
  accountId           String          @id @db.Uuid
  citizenId           String          @unique @db.VarChar(12)
  propertyTaxNumber   String          @unique @db.VarChar(30)
  propertyType        String          @db.VarChar(30)
  propertyArea        Float?
  propertyValue       Decimal?        @db.Decimal(12, 2)
  constructionYear    Int?
  numberOfFloors      Int?
  status              String          @db.VarChar(20)
  annualTaxAmount     Decimal?        @db.Decimal(10, 2)
  taxCategory         String?         @db.VarChar(30)
  lastBillAmount      Decimal?        @db.Decimal(10, 2)
  lastBillDate        DateTime?       @db.Date
  dueAmount           Decimal?        @db.Decimal(10, 2)
  garbageCollection   Boolean         @default(true)
  drainageConnection  Boolean         @default(true)
  streetLightCoverage Boolean         @default(true)
  registrationDate    DateTime?       @db.Date
  createdAt           DateTime        @default(now())
  updatedAt           DateTime
  citizen             Citizen         @relation(fields: [citizenId], references: [aadharNumber], onDelete: Cascade)
  taxBills            MunicipalBill[]

  @@index([propertyTaxNumber])
  @@map("municipal_accounts")
}

model MunicipalBill {
  billId        String           @id @db.Uuid
  accountId     String           @db.Uuid
  billNumber    String           @unique @db.VarChar(30)
  billingPeriod String           @db.VarChar(20)
  financialYear String           @db.VarChar(10)
  propertyTax   Decimal          @db.Decimal(10, 2)
  waterTax      Decimal?         @db.Decimal(10, 2)
  sewerageTax   Decimal?         @db.Decimal(10, 2)
  garbageTax    Decimal?         @db.Decimal(10, 2)
  educationCess Decimal?         @db.Decimal(10, 2)
  otherCharges  Decimal?         @db.Decimal(10, 2)
  totalAmount   Decimal          @db.Decimal(10, 2)
  dueDate       DateTime         @db.Date
  status        String           @db.VarChar(20)
  createdAt     DateTime         @default(now())
  account       MunicipalAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  payments      Payment[]

  @@index([accountId])
  @@map("municipal_bills")
}

model WaterAccount {
  accountId          String             @id @db.Uuid
  citizenId          String             @unique @db.VarChar(12)
  consumerNumber     String             @unique @db.VarChar(30)
  connectionType     String             @db.VarChar(20)
  pipeSize           String?            @db.VarChar(20)
  numberOfTaps       Int?
  meterNumber        String?            @db.VarChar(30)
  status             String             @db.VarChar(20)
  currentMonthUsage  Float?
  dailyAverage       Float?
  waterPressure      Float?
  lastBillAmount     Decimal?           @db.Decimal(10, 2)
  lastBillDate       DateTime?          @db.Date
  dueAmount          Decimal?           @db.Decimal(10, 2)
  lastMeterReading   Float?
  lastReadingDate    DateTime?
  nextReadingDate    DateTime?          @db.Date
  lastQualityTest    DateTime?          @db.Date
  waterQualityStatus String?            @db.VarChar(20)
  phLevel            Float?
  tdsLevel           Float?
  chlorineLevel      Float?
  turbidityLevel     Float?
  hardnessLevel      Float?
  connectionDate     DateTime?          @db.Date
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  citizen            Citizen            @relation(fields: [citizenId], references: [aadharNumber], onDelete: Cascade)
  bills              WaterBill[]
  consumptionHistory WaterConsumption[]

  @@index([consumerNumber])
  @@map("water_accounts")
}

model WaterBill {
  billId           String       @id @db.Uuid
  accountId        String       @db.Uuid
  billNumber       String       @unique @db.VarChar(30)
  billingPeriod    String       @db.VarChar(20)
  billingStartDate DateTime     @db.Date
  billingEndDate   DateTime     @db.Date
  unitsConsumed    Float
  previousReading  Float
  currentReading   Float
  waterCharges     Decimal      @db.Decimal(10, 2)
  sewerageCharges  Decimal?     @db.Decimal(10, 2)
  fixedCharges     Decimal      @db.Decimal(10, 2)
  taxAmount        Decimal      @db.Decimal(10, 2)
  totalAmount      Decimal      @db.Decimal(10, 2)
  dueDate          DateTime     @db.Date
  status           String       @db.VarChar(20)
  createdAt        DateTime     @default(now())
  payments         Payment[]
  account          WaterAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@map("water_bills")
}

model WaterConsumption {
  id          String       @id @db.Uuid
  accountId   String       @db.Uuid
  date        DateTime     @db.Date
  consumption Float
  pressure    Float?
  cost        Decimal?     @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  account     WaterAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, date])
  @@map("water_consumption")
}
