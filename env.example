# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=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

# ── Optional: choose a different model ────────────────────────
# Free models on Groq that support tool calling:
#   llama-3.3-70b-versatile   (best, default)
#   llama-3.1-8b-instant      (faster, lighter)
#   gemma2-9b-it              (Google Gemma)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional: Auth ────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── Optional: AWS S3 ──────────────────────────────────────────
