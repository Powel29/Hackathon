# SUVIDHA Kiosk - Kiosk Pilot Environment
# Deployed on physical kiosk hardware.
# KIOSK_LOCKDOWN=true disables back navigation and external link escapes.
VITE_ENV_PROFILE=kiosk-pilot
VITE_API_URL=https://pilot.suvidha.gov.in/api
VITE_KIOSK_LOCKDOWN=true
VITE_SESSION_WARNING_MS=60000
VITE_SESSION_TIMEOUT_MS=90000
VITE_FEATURE_OFFLINE_QUEUE=true
VITE_FEATURE_VOICE=false
VITE_FEATURE_EASY_MODE=true
VITE_FEATURE_ANALYTICS=true
